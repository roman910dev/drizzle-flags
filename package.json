{
	"name": "drizzle-flags",
	"version": "0.0.4-unreleased",
	"description": "Use flags columns in drizzle. These columns can store multiple boolean values using a single integer column, which can save up a lot of space.",
	"author": "Román Via-Dufresne Saus <roman910dev@gmail.com>",
	"homepage": "https://github.com/roman910dev/drizzle-flags",
	"repository": {
		"type": "git",
		"url": "https://github.com/roman910dev/drizzle-flags.git"
	},
	"type": "module",
	"main": "dist/src/index.js",
	"types": "dist/src/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc --build tsconfig.build.json",
		"check": "biome check .",
		"fix": "biome check --fix .",
		"full-check": "pnpm ts && pnpm check",
		"format": "biome format --write . & prettier --write .",
		"prepublish": "tsc",
		"test": "mocha",
		"ts": "tsc --noEmit"
	},
	"keywords": [
		"drizzle",
		"flags",
		"orm",
		"typescript"
	],
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"@types/chai": "^4.3.16",
		"@types/mocha": "^10.0.6",
		"@types/node": "^24.5.2",
		"chai": "^5.1.1",
		"dotenv": "^16.4.5",
		"mocha": "^10.4.0",
		"mysql2": "^3.9.8",
		"prettier": "^3.2.5",
		"tsx": "^4.11.0",
		"typescript": "^5.9.2"
	},
	"dependencies": {
		"drizzle-orm": "*"
	}
}
